# Copy to .env and fill in your values for LOCAL runs only. Do not commit .env.
#
#   cp .env.example .env
#   set -a && source .env && set +a
#
# Inside the SPCS job container none of this is needed except the first block:
# Snowflake auto-injects SNOWFLAKE_ACCOUNT/SNOWFLAKE_HOST and mounts an OAuth
# token at /snowflake/session/token, which gdelt_incremental/config.py detects
# automatically (AUTHORIZATION_TYPE=SPCS).

# ── Snowflake target (required) ───────────────────────────────────────────────
SNOWFLAKE_DATABASE=MY_DB
# All GDELT objects (tables, pipes, watermark state, compute pool, image repo,
# task, job spec stage) live in this dedicated schema.
SNOWFLAKE_SCHEMA=GDELT
# Optional: only for local setup scripts (create_gdelt_tables.py), not the SPCS job.
SNOWFLAKE_WAREHOUSE=GDELT_LOADER_WH
SNOWFLAKE_TABLE_EVENTS=EVENTS
SNOWFLAKE_TABLE_MENTIONS=EVENTMENTIONS
SNOWFLAKE_TABLE_GKG=GKG
SNOWFLAKE_ROLE=GDELT_LOADER_ROLE
# Watermark progress = standard channel offset token (not warehouse SQL).
# SNOWFLAKE_WATERMARK_TABLE=GDELT_WATERMARK
# SNOWFLAKE_WATERMARK_CHANNEL=gdelt_watermark
# SNOWFLAKE_PIPE_WATERMARK=GDELT_WATERMARK_MATCH_BY_COLUMN
# WATERMARK_COMMIT_TIMEOUT_SEC=120

# ── Snowflake SDK credentials (required for LOCAL runs / one-time setup) ──────
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=INGEST_SVC
SNOWFLAKE_URL=https://xy12345.us-east-1.snowflakecomputing.com
# One-time setup: set SNOWFLAKE_PASSWORD, then run scripts/setup_snowflake_keypair.py
# SNOWFLAKE_PASSWORD=your_password_or_programmatic_access_token
# PEM on one line (backslash-n for newlines inside the key)
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional explicit pipe names (default: <table>_MATCH_BY_COLUMN)
# SNOWFLAKE_PIPE_EVENTS=EVENTS_MATCH_BY_COLUMN
# SNOWFLAKE_PIPE_MENTIONS=EVENTMENTIONS_MATCH_BY_COLUMN
# SNOWFLAKE_PIPE_GKG=GKG_MATCH_BY_COLUMN

# Prefix for the per-run StreamingIngestClient name
# SNOWFLAKE_CLIENT_NAME=gdelt-incremental

# ── Incremental ingest tuning (optional) ──────────────────────────────────────
# Progress: next_window = last_watermark + 15 minutes; after ingest set
# watermark = that window's YYYYMMDDHHMMSS. Cold start (empty watermark) loads
# only the wall-clock ceiling window (~last 15 minutes) — no backfill.
# URLs are constructed; lastupdate.txt / masterfilelist.txt are not used.
# GDELT_BASE_URL=http://data.gdeltproject.org/gdeltv2
# Completed windows behind wall-clock used as the ingest ceiling.
# GDELT_LATEST_LAG_WINDOWS=1
# BATCH_SIZE=1000
# Max +15m catch-up windows in one job run (remaining gap closes later).
# MAX_CATCHUP_WINDOWS=8
# Optional: seed offset after recreate (omit for cold start).
# SEED_WATERMARK_TIMESTAMP=20260727204500
# APPEND_ROWS_MAX_RETRIES=5
# APPEND_ROWS_BACKOFF_BASE_SEC=0.5
# APPEND_ROWS_BACKOFF_MAX_SEC=30.0
# DATA_DIR=/tmp/gdelt

# ── SPCS deployment (optional, used by scripts/deploy.sh) ─────────────────────
# SPCS_COMPUTE_POOL=GDELT_INCREMENTAL_POOL
# SPCS_IMAGE_REPO=GDELT_LOADER_REPO
# SPCS_STAGE=GDELT_STAGE
# SPCS_JOB_NAME=GDELT_INCREMENTAL_JOB
# SPCS_TASK_NAME=GDELT_INCREMENTAL_TASK
# SPCS_INSTANCE_FAMILY=CPU_X64_XS
